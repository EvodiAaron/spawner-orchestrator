local PARENT = {
  settings = "main",
  edit = "settings",
  pick_target = "edit",
  pick_side = "edit",
  integrators = "settings",
  scan = "integrators",
  pick_timer = "main",
  pick_color = "settings",
  pick_interval = "edit",
}

local function openScreen(name)
  ui.screen = name
  ui.sel = 1
  ui.scroll = 0
  refreshItems()
  redraw()
end

local function openConfirm(title, lines, options, backTo)
  ui.confirm = { title = title, lines = lines, options = options, backTo = backTo }
  openScreen("confirm")
end

local function openInput(title, prompt, initial, onSubmit, backTo)
  ui.input = {
    title = title,
    prompt = prompt,
    buffer = initial or "",
    onSubmit = onSubmit,
    backTo = backTo,
  }
  ui.screen = "input"
  redraw()
end

local function finishInput(text)
  local inp = ui.input
  ui.input = nil
  openScreen(inp.backTo)
  -- text is nil when the entry was cancelled; the callback only runs on
  -- an accepted entry
  if text ~= nil and inp.onSubmit then inp.onSubmit(text) end
  refreshItems()
  redraw()
end

local function goBack()
  local s = ui.screen
  if s == "input" then
    finishInput(nil)
  elseif s == "confirm" then
    local backTo = (ui.confirm and ui.confirm.backTo) or "settings"
    ui.confirm = nil
    openScreen(backTo)
  elseif PARENT[s] then
    openScreen(PARENT[s])
  end
end

-- ---------------------------------------------------------------------
-- actions
-- ---------------------------------------------------------------------

local function toggleSpawner(i)
  local sp = config.spawners[i]
  if not sp then return end
  -- a manual toggle always cancels a running countdown; toggling on
  -- runs for the default timer mode (0 = on indefinitely)
  cancelSpawnerTimer(sp)
  sp.state = not sp.state
  if sp.state and not sp.ignoreTimer and (config.timerMode or 0) > 0 then
    timerEnds[sp] = os.clock() + config.timerMode
  end
  if sp.state and (sp.interval or 0) > 0 then
    startInterval(sp)
  else
    stopInterval(sp)
  end
  ensureTick()
  applyOutput(sp)
  saveConfig()
  if sp.target == "none" then
    ui.status = sp.name .. " has no output assigned"
  elseif spawnerOffline(sp) then
    ui.status = sp.name .. ": output offline!"
  end
  redraw()
end

-- master switch: if anything is on, turn everything off; otherwise turn
-- everything on. running countdowns are cancelled either way. spawners
-- with bypassAll set are invisible to this switch in both directions
local function toggleAll()
  local affected = {}
  for _, sp in ipairs(config.spawners) do
    if not sp.bypassAll then affected[#affected + 1] = sp end
  end
  if #affected == 0 then
    if #config.spawners > 0 then
      ui.status = "every item bypasses Toggle All"
      redraw()
    end
    return
  end
  local anyOn = false
  for _, sp in ipairs(affected) do
    if sp.state then
      anyOn = true
      break
    end
  end
  local newState = not anyOn
  for _, sp in ipairs(affected) do
    cancelSpawnerTimer(sp)
    sp.state = newState
    if newState and not sp.ignoreTimer and (config.timerMode or 0) > 0 then
      timerEnds[sp] = os.clock() + config.timerMode
    end
    if newState and (sp.interval or 0) > 0 then
      startInterval(sp)
    else
      stopInterval(sp)
    end
    applyOutput(sp)
  end
  ensureTick()
  saveConfig()
  ui.status = newState and "all items ON" or "all items OFF"
  redraw()
end

-- step the persistent default timer to the next preset (wraps around)
local function cycleTimerMode()
  local mode = config.timerMode or 0
  local idx = 1
  for i, m in ipairs(TIMER_MODES) do
    if m.secs == mode then
      idx = i
      break
    end
  end
  idx = idx + 1
  if idx > #TIMER_MODES then idx = 1 end
  config.timerMode = TIMER_MODES[idx].secs
  saveConfig()
  ui.status = "default timer: " .. TIMER_MODES[idx].label
  redraw()
end

local function startSpawnerTimer(i, secs)
  local sp = config.spawners[i]
  if not sp then return end
  if sp.ignoreTimer then
    -- this spawner never takes a timer; just make sure it is on
    sp.state = true
    if (sp.interval or 0) > 0 then startInterval(sp) end
    ensureTick()
    applyOutput(sp)
    saveConfig()
    ui.status = sp.name .. " ignores timers - turned on"
    return
  end
  sp.state = true
  timerEnds[sp] = os.clock() + secs
  if (sp.interval or 0) > 0 then startInterval(sp) end
  applyOutput(sp)
  saveConfig()
  ensureTick()
  ui.status = sp.name .. " on for " .. formatCountdown(secs)
end

-- fires once a second while any countdown or interval pulse is running:
-- turns off expired spawners, flips due pulse phases, refreshes the
-- countdown display
local function onTick()
  local now = os.clock()
  local expired = {}
  for sp, endT in pairs(timerEnds) do
    if endT <= now then expired[#expired + 1] = sp end
  end
  for _, sp in ipairs(expired) do
    cancelSpawnerTimer(sp)
    sp.state = false
    stopInterval(sp)
    applyOutput(sp)
    ui.status = sp.name .. " timer done - turned off"
  end
  for _, sp in ipairs(config.spawners) do
    if sp.state and (sp.interval or 0) > 0 then
      local nextAt = intervalNext[sp]
      if not nextAt then
        startInterval(sp)
      elseif nextAt <= now then
        intervalPhase[sp] = not (intervalPhase[sp] ~= false)
        intervalNext[sp] = now + sp.interval
        applyOutput(sp)
      end
    end
  end
  if #expired > 0 then saveConfig() end
  ensureTick()
  if ui.screen == "main" then redraw() end
end

local function activate(it)
  local k = it.kind
  local sp = config.spawners[ui.editIndex]
  if k == "noop" then
    return
  elseif k == "back" then
    goBack()
  elseif k == "spawner" then
    ui.editIndex = it.index
    openScreen("edit")
  elseif k == "add" then
    -- new spawners start unassigned so adding one never flips a face of
    -- the computer that might already be wired to something
    table.insert(config.spawners, {
      name = "Item " .. tostring(#config.spawners + 1),
      target = "none",
      side = "none",
      inverted = false,
      state = false,
      ignoreTimer = false,
      bypassAll = false,
      itemType = "spawner",
    })
    saveConfig()
    ui.editIndex = #config.spawners
    ui.status = "item added - set a name, type and target"
    openScreen("edit")
  elseif k == "integrators" then
    openScreen("integrators")
  elseif k == "rename" then
    if sp then
      openInput("Rename item", "New name:", sp.name, function(text)
        if text ~= "" then
          sp.name = truncate(text, MAX_NAME_LEN)
          saveConfig()
        end
      end, "edit")
    end
  elseif k == "target" then
    if sp then openScreen("pick_target") end
  elseif k == "side" then
    if sp then
      if sp.target == "none" then
        ui.status = "assign a target first"
        redraw()
      else
        openScreen("pick_side")
      end
    end
  elseif k == "inverted" then
    if sp then
      sp.inverted = not sp.inverted
      -- the same logical state now needs the opposite electrical level
      applyOutput(sp)
      saveConfig()
      refreshItems()
      redraw()
    end
  elseif k == "interval" then
    if sp then openScreen("pick_interval") end
  elseif k == "intervalopt" then
    if sp then
      sp.interval = (it.secs > 0) and it.secs or nil
      if sp.state and (sp.interval or 0) > 0 then
        startInterval(sp)
        ensureTick()
      else
        stopInterval(sp)
      end
      applyOutput(sp)
      saveConfig()
      openScreen("edit")
    end
  elseif k == "ignoretimer" then
    if sp then
      sp.ignoreTimer = not sp.ignoreTimer
      -- an already-running countdown would defeat the point
      if sp.ignoreTimer then cancelSpawnerTimer(sp) end
      saveConfig()
      refreshItems()
      redraw()
    end
  elseif k == "bypassall" then
    if sp then
      sp.bypassAll = not sp.bypassAll
      saveConfig()
      refreshItems()
      redraw()
    end
  elseif k == "itemtype" then
    if sp then
      -- utilities group below spawners; drop the obsolete pos field so it
      -- can never contradict the type
      sp.itemType = (sp.itemType == "utility") and "spawner" or "utility"
      sp.pos = nil
      saveConfig()
      refreshItems()
      redraw()
    end
  elseif k == "moveup" or k == "movedown" then
    if sp then
      local i = ui.editIndex
      local j = (k == "moveup") and i - 1 or i + 1
      if config.spawners[j] then
        config.spawners[i], config.spawners[j] = config.spawners[j], config.spawners[i]
        ui.editIndex = j
        saveConfig()
        ui.status = "moved to position " .. tostring(j)
        refreshItems()
        redraw()
      else
        ui.status = "already at the " .. ((k == "moveup") and "top" or "bottom")
        redraw()
      end
    end
  elseif k == "remove" then
    if sp then
      openConfirm("Remove item",
        { "Remove \"" .. sp.name .. "\"?", "Its output will be turned off." },
        {
          { label = "Remove", fn = function()
              cancelSpawnerTimer(sp)
              stopInterval(sp)
              forceLogicalOff(sp)
              for i, s in ipairs(config.spawners) do
                if s == sp then
                  table.remove(config.spawners, i)
                  break
                end
              end
              applyFailed[sp] = nil
              saveConfig()
              if ui.mainSel > #config.spawners then
                ui.mainSel = math.max(1, #config.spawners)
              end
              ui.editIndex = nil
              ui.status = "item removed"
              openScreen("settings")
            end },
          { label = "Cancel", fn = function() openScreen("edit") end },
        }, "edit")
    end
  elseif k == "targetopt" then
    if sp then
      -- release the face we are leaving before pointing anywhere else
      forceLogicalOff(sp)
      sp.target = it.value
      if it.value == "none" then
        sp.side = "none"
        saveConfig()
        openScreen("edit")
      else
        if not isValidSide(sp.target, sp.side) then
          sp.side = sidesFor(sp.target)[1]
        end
        applyOutput(sp)
        saveConfig()
        -- go straight to the side picker so the side is a conscious choice
        openScreen("pick_side")
      end
    end
  elseif k == "sideopt" then
    if sp then
      forceLogicalOff(sp)
      sp.side = it.value
      applyOutput(sp)
      saveConfig()
      openScreen("edit")
    end
  elseif k == "integ" then
    local name = it.name
    openConfirm("Integrator", { integLabel(name) }, {
      { label = "Set label", fn = function()
          local current = (config.integratorLabels and config.integratorLabels[name]) or ""
          openInput("Label integrator", "Label (empty clears it):", current, function(text)
            if not config.integratorLabels then config.integratorLabels = {} end
            if text == "" then
              config.integratorLabels[name] = nil
              ui.status = "label cleared"
            else
              config.integratorLabels[name] = truncate(text, MAX_NAME_LEN)
              ui.status = "label saved"
            end
            saveConfig()
          end, "integrators")
        end },
      { label = "Remove", fn = function() activate({ kind = "integremove", name = name }) end },
      { label = "Cancel", fn = function() openScreen("integrators") end },
    }, "integrators")
  elseif k == "integremove" then
    local name = it.name
    local users = {}
    for _, s in ipairs(config.spawners) do
      if s.target == name then users[#users + 1] = s end
    end
    if #users == 0 then
      openConfirm("Remove integrator", { "Remove \"" .. name .. "\"?" }, {
        { label = "Remove", fn = function()
            removeIntegratorByName(name)
            saveConfig()
            ui.status = "integrator removed"
            openScreen("integrators")
          end },
        { label = "Cancel", fn = function() openScreen("integrators") end },
      }, "integrators")
    else
      -- never leave dangling references: removal reassigns the affected
      -- spawners to an explicit unassigned state, off
      openConfirm("Integrator is in use",
        { "\"" .. name .. "\" is used by " .. tostring(#users) .. " item(s)." },
        {
          { label = "Turn them off, unassign, and remove", fn = function()
              for _, s in ipairs(users) do
                cancelSpawnerTimer(s)
                stopInterval(s)
                forceLogicalOff(s)
                s.state = false
                s.target = "none"
                s.side = "none"
                applyFailed[s] = nil
              end
              removeIntegratorByName(name)
              saveConfig()
              ui.status = "removed; items set to unassigned"
              openScreen("integrators")
            end },
          { label = "Cancel", fn = function() openScreen("integrators") end },
        }, "integrators")
    end
  elseif k == "scan" then
    openScreen("scan")
  elseif k == "rescan" then
    refreshItems()
    redraw()
  elseif k == "manual" then
    openInput("Add integrator", "Peripheral name:", "", function(text)
      if text == "" then return end
      if knownIntegrator(text) then
        ui.status = "already in the list"
      elseif peripheral.isPresent(text)
        and peripheral.getType(text) ~= "redstone_integrator" then
        ui.status = "that peripheral is not a redstone_integrator"
      else
        table.insert(config.integrators, text)
        saveConfig()
        if peripheral.isPresent(text) then
          ui.status = "integrator added"
        else
          ui.status = "added (not currently attached)"
        end
      end
    end, "integrators")
  elseif k == "found" then
    table.insert(config.integrators, it.name)
    saveConfig()
    ui.status = "added " .. it.name
    refreshItems()
    redraw()
  elseif k == "timeropt" then
    startSpawnerTimer(ui.timerIndex, it.secs)
    openScreen("main")
  elseif k == "headercolor" then
    openScreen("pick_color")
  elseif k == "coloropt" then
    config.headerColor = it.value
    saveConfig()
    ui.status = "header colour: " .. it.value
    openScreen("settings")
  elseif k == "confirmopt" then
    local fn = it.fn
    ui.confirm = nil
    fn()
  end
end

-- ---------------------------------------------------------------------
-- input handling (one event loop owns everything; no read())
-- ---------------------------------------------------------------------

local function handleMainKey(code)
  local n = #config.spawners
  if code == keys.up then
    if n > 0 and ui.mainSel > 1 then
      ui.mainSel = ui.mainSel - 1
      clampMainScroll()
      redraw()
    end
  elseif code == keys.down then
    if n > 0 and ui.mainSel < n then
      ui.mainSel = ui.mainSel + 1
      clampMainScroll()
      redraw()
    end
  elseif code == keys.space then
    if n > 0 then toggleSpawner(displayOrder()[ui.mainSel]) end
  elseif code == keys.tab then
    toggleAll()
  end
end

local function handleMenuKey(code)
  if code == keys.up then
    if ui.sel > 1 then
      ui.sel = ui.sel - 1
      clampMenuScroll()
      redraw()
    end
  elseif code == keys.down then
    if ui.sel < #ui.items then
      ui.sel = ui.sel + 1
      clampMenuScroll()
      redraw()
    end
  elseif code == keys.enter then
    local it = ui.items[ui.sel]
    if it then activate(it) end
  elseif code == keys.backspace then
    goBack()
  elseif code == keys.space then
    -- convenience: space also flips yes/no style fields when selected
    local it = ui.items[ui.sel]
    if it and (it.kind == "inverted" or it.kind == "ignoretimer"
      or it.kind == "bypassall" or it.kind == "itemtype") then
      activate(it)
    end
  end
end

local function handleInputKey(code)
  if code == keys.enter then
    finishInput(ui.input.buffer)
  elseif code == keys.backspace then
    if #ui.input.buffer > 0 then
      ui.input.buffer = string.sub(ui.input.buffer, 1, -2)
      redraw()
    else
      finishInput(nil)
    end
  end
end

local function handleKey(code)
  if ui.screen == "main" then
    handleMainKey(code)
  elseif ui.screen == "input" then
    handleInputKey(code)
  else
    handleMenuKey(code)
  end
end

local function handleChar(ch)
  if ui.screen == "input" then
    if #ui.input.buffer < MAX_INPUT_LEN then
      ui.input.buffer = ui.input.buffer .. ch
      redraw()
    end
  elseif ui.screen == "main" then
    if ch == "a" or ch == "A" or ch == "s" or ch == "S" then
      openScreen("settings")
    elseif ch == "t" or ch == "T" then
      if #config.spawners > 0 then
        ui.timerIndex = displayOrder()[ui.mainSel]
        openScreen("pick_timer")
      end
    elseif ch == "m" or ch == "M" then
      cycleTimerMode()
    end
  elseif ui.screen == "settings" then
    -- bios-style reordering: +/- moves the selected spawner row; "=" and
    -- "_" are accepted so shift state does not matter
    local up = (ch == "+" or ch == "=")
    local down = (ch == "-" or ch == "_")
    if up or down then
      local it = ui.items[ui.sel]
      if it and it.kind == "spawner" then
        local i = it.index
        local j = up and i - 1 or i + 1
        if config.spawners[j] then
          config.spawners[i], config.spawners[j] = config.spawners[j], config.spawners[i]
          saveConfig()
          -- keep the selection on the spawner that moved
          ui.sel = ui.sel + (j - i)
          clampMenuScroll()
          ui.status = "moved " .. config.spawners[j].name
          refreshItems()
          redraw()
        end
      end
    end
  end
end

-- which item, if any, sits under (x, y) on monitor m: full-width rows
-- first, then the two-column utility hitboxes
local function monHitIndex(m, x, y)
  if m.rowMap[y] then return m.rowMap[y] end
  for _, c in ipairs(m.cells) do
    if c.y == y and x >= c.x1 and x <= c.x2 then return c.index end
  end
  return nil
end

local function hitButton(btn, x, y)
  return btn and y == btn.y and x >= btn.x1 and x <= btn.x2
end

local function handleTouch(name, x, y)
  if ui.screen ~= "main" then
    -- monitors show a notice while settings are open; ignore taps
    return
  end
  local m
  if name == monPrimary.name then
    m = monPrimary
  elseif name == monUtil.name then
    m = monUtil
  else
    return
  end
  local i = monHitIndex(m, x, y)
  if i and config.spawners[i] then
    -- move the terminal selection too so both displays stay in step
    for p, ci in ipairs(displayOrder()) do
      if ci == i then
        ui.mainSel = p
        break
      end
    end
    clampMainScroll()
    toggleSpawner(i)
    return
  end
  -- control buttons only exist on the primary monitor; they may share a
  -- row, so match by hitbox rather than row alone
  if hitButton(m.toggleAllBtn, x, y) then
    toggleAll()
    return
  end
  if hitButton(m.timerBtn, x, y) then
    cycleTimerMode()
  end
end

local function onPeripheralChange()
  findMonitors()
  -- reapply everything: a reattached integrator comes back with its
  -- outputs reset, and the pcall failures refresh each spawner's
  -- offline flag
  applyAll()
  if ui.screen ~= "main" and ui.screen ~= "input" and ui.screen ~= "confirm" then
    refreshItems()
  end
  redraw()
end

-- ---------------------------------------------------------------------
-- main loop
-- ---------------------------------------------------------------------

local function eventLoop()
  while true do
    -- os.pullEvent (not pullEventRaw) so ctrl+t terminates normally;
    -- the pcall around main() turns that into a clean exit
    local ev, a, b, c = os.pullEvent()
    if ev == "key" then
      ui.status = nil
      handleKey(a)
    elseif ev == "char" then
      handleChar(a)
    elseif ev == "monitor_touch" then
      ui.status = nil
      handleTouch(a, b, c)
    elseif ev == "timer" then
      if a == tickTimerId then
        tickTimerId = nil
        onTick()
      end
    elseif ev == "peripheral" or ev == "peripheral_detach" then
      onPeripheralChange()
    elseif ev == "monitor_resize" then
      findMonitors()
      redraw()
    elseif ev == "term_resize" then
      if ui.screen == "main" then clampMainScroll() else clampMenuScroll() end
      redraw()
    end
  end
end

local function main()
  loadConfig()
  -- resume any countdown that was running when we last saved; it picks
  -- up from the remaining time recorded at that save
  for _, sp in ipairs(config.spawners) do
    if type(sp.timerLeft) == "number" and sp.timerLeft > 0 and sp.state
      and not sp.ignoreTimer then
      timerEnds[sp] = os.clock() + sp.timerLeft
    else
      sp.timerLeft = nil
    end
    -- interval spawners restart their pulse at the on phase after a boot
    if sp.state and (sp.interval or 0) > 0 then
      startInterval(sp)
    end
  end
  ensureTick()
  findMonitors()
  -- a reboot clears every redstone output, so restore each saved state
  -- before drawing anything; this restore is why the file is "startup"
  applyAll()
  redraw()
  eventLoop()
end

local ok, err = pcall(main)

-- always restore the terminal, whether we stopped via ctrl+t or a bug
if term.isColor() then
  term.setBackgroundColor(colors.black)
  term.setTextColor(colors.white)
end
term.clear()
term.setCursorPos(1, 1)
-- setCursorBlink is core term api in every cc version; pcall just in case
pcall(term.setCursorBlink, true)

for _, m in ipairs({ monPrimary, monUtil }) do
  if m.dev then
    pcall(function()
      if m.color then
        m.dev.setBackgroundColor(colors.black)
        m.dev.setTextColor(colors.white)
      end
      m.dev.clear()
      m.dev.setCursorPos(1, 1)
      m.dev.write("panel stopped")
    end)
  end
end

if not ok then
  if tostring(err) == "Terminated" then
    print("Spawner panel terminated.")
  else
    print("Spawner panel crashed:")
    print(tostring(err))
  end
  print("Outputs keep their last state until reboot.")
end
