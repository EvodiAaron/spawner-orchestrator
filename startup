-- column layout for the two-column utility block: one column on narrow
-- monitors, two side by side once there is room. content ends at w-1 so
-- the last column stays free for scroll arrows
local function utilColumns(w)
  if w < MIN_TWOCOL_W then
    return { { x = 2, w = math.max(1, w - 2) } }
  end
  local col2x = math.floor(w / 2) + 1
  return {
    { x = 2, w = math.max(1, col2x - 3) },     -- ends at col2x-2, 1-col gap
    { x = col2x, w = math.max(1, w - col2x) },  -- ends at w-1
  }
end

-- a utility drawn inside one column cell: dimmed name, offline marker,
-- right-aligned status bracket. records the cell as a touch hitbox
local function drawUtilCell(m, sp, i, x, y, cellW)
  local d, color = m.dev, m.color
  local xEnd = x + cellW - 1
  m.cells[#m.cells + 1] = { y = y, x1 = x, x2 = xEnd, index = i }
  local text, col = spawnerStatusText(sp)
  local bracketW = #text + 2
  local offline = spawnerOffline(sp)
  local nameW = cellW - bracketW - (offline and 2 or 0)
  if nameW < 1 then nameW = 1 end
  d.setCursorPos(x, y)
  if color then d.setTextColor(colors.lightGray) end -- utilities read dimmed
  d.write(truncate(sp.name, nameW))
  if color then d.setTextColor(colors.white) end
  if offline then
    if color then d.setTextColor(colors.yellow) end
    d.setCursorPos(xEnd - bracketW, y)
    d.write("!")
    if color then d.setTextColor(colors.white) end
  end
  d.setCursorPos(xEnd - bracketW + 1, y)
  d.write("[")
  if color then d.setTextColor(col) end
  d.write(text)
  if color then d.setTextColor(colors.white) end
  d.write("]")
end

-- lay out the utility list across columns within rows [yTop, yTop+rows-1],
-- filling row-major. anchorBottom pins the block to the last rows
local function drawUtilList(m, utilIdx, yTop, rows, w, anchorBottom)
  local cols = utilColumns(w)
  local ncol = #cols
  local need = math.ceil(#utilIdx / ncol)
  if need > rows then need = rows end
  local startY = anchorBottom and (yTop + rows - need) or yTop
  if startY < yTop then startY = yTop end
  local k = 1
  for r = 0, need - 1 do
    local y = startY + r
    for c = 1, ncol do
      local idx = utilIdx[k]
      if idx and config.spawners[idx] then
        drawUtilCell(m, config.spawners[idx], idx, cols[c].x, y, cols[c].w)
      end
      k = k + 1
    end
  end
end

-- a full-width row: name, optional countdown, offline marker, status
local function drawSpawnerRow(m, sp, i, y, w)
  local d, color = m.dev, m.color
  m.rowMap[y] = i
  local endT = timerEnds[sp]
  local showTimer = endT and w >= 22
  d.setCursorPos(2, y)
  -- utilities render dimmed so they read as a secondary group
  if isUtility(sp) and color then d.setTextColor(colors.lightGray) end
  d.write(truncate(sp.name, showTimer and (w - 17) or (w - 9)))
  if color then d.setTextColor(colors.white) end
  if showTimer then
    local cd = formatCountdown(endT - os.clock())
    if color then d.setTextColor(colors.cyan) end
    d.setCursorPos(w - 8 - #cd, y)
    d.write(cd)
    if color then d.setTextColor(colors.white) end
  end
  if spawnerOffline(sp) then
    if color then d.setTextColor(colors.yellow) end
    d.setCursorPos(w - 7, y)
    d.write("!")
    if color then d.setTextColor(colors.white) end
  end
  local text, col = spawnerStatusText(sp)
  -- right-align the bracket group so "]" always sits at w-1
  d.setCursorPos(w - 2 - #text, y)
  d.write("[")
  if color then d.setTextColor(col) end
  d.write(text)
  if color then d.setTextColor(colors.white) end
  d.write("]")
end

-- centred full-width heading bar
local function drawMonHeading(m, w, title)
  local d = m.dev
  if m.color then
    local bg, fg = headerStyle()
    d.setBackgroundColor(bg)
    d.setTextColor(fg)
  end
  d.setCursorPos(1, 1)
  d.clearLine()
  d.setCursorPos(math.max(1, math.floor((w - #title) / 2) + 1), 1)
  d.write(truncate(title, w))
  if m.color then
    d.setBackgroundColor(colors.black)
    d.setTextColor(colors.white)
  end
end

-- the "settings open" notice shown on a monitor while the terminal is busy
local function drawNoticeOn(d, w, h)
  local msg1 = "Configuration in"
  local msg2 = "progress on terminal"
  local midY = math.max(1, math.floor(h / 2))
  d.setCursorPos(math.max(1, math.floor((w - #msg1) / 2) + 1), midY)
  d.write(truncate(msg1, w))
  if midY + 1 <= h then
    d.setCursorPos(math.max(1, math.floor((w - #msg2) / 2) + 1), midY + 1)
    d.write(truncate(msg2, w))
  end
end

local function drawScrollArrows(m, w, listH, scroll, n)
  local d = m.dev
  if scroll > 0 then
    d.setCursorPos(w, 2)
    d.write("^")
  end
  if scroll + listH < n then
    d.setCursorPos(w, 1 + listH)
    d.write("v")
  end
end

-- how many bottom rows the primary controls occupy at a given width: one
-- combined row when there is room for both labels, otherwise two stacked
local function primaryCtrlRows(w)
  return (w >= CTRL_ONE_ROW_MIN_W) and 1 or 2
end

-- the master switch and default-timer selector along the bottom of a
-- touch monitor; settings themselves live on the terminal. wide monitors
-- put both on the last row, narrow ones stack them. each button records a
-- hitbox so a tap on a shared row still lands on the right control
local function drawControlRows(m, w, h)
  local d = m.dev
  local tgl = "[ Toggle All ]"
  local tmr = "[ Timer: " .. timerModeLabel() .. " ]"
  if primaryCtrlRows(w) == 1 then
    local gap = 2
    local total = #tgl + gap + #tmr
    local x0 = math.max(1, math.floor((w - total) / 2) + 1)
    d.setTextColor(colors.yellow)
    d.setCursorPos(x0, h)
    d.write(tgl)
    d.setTextColor(colors.cyan)
    d.setCursorPos(x0 + #tgl + gap, h)
    d.write(tmr)
    d.setTextColor(colors.white)
    m.toggleAllBtn = { y = h, x1 = x0, x2 = x0 + #tgl - 1 }
    m.timerBtn = { y = h, x1 = x0 + #tgl + gap, x2 = x0 + #tgl + gap + #tmr - 1 }
  else
    d.setTextColor(colors.yellow)
    d.setCursorPos(math.max(1, math.floor((w - #tgl) / 2) + 1), h - 1)
    d.write(truncate(tgl, w))
    d.setTextColor(colors.cyan)
    d.setCursorPos(math.max(1, math.floor((w - #tmr) / 2) + 1), h)
    d.write(truncate(tmr, w))
    d.setTextColor(colors.white)
    -- a stacked button owns its whole row
    m.toggleAllBtn = { y = h - 1, x1 = 1, x2 = w }
    m.timerBtn = { y = h, x1 = 1, x2 = w }
  end
end

local function drawPrimaryRaw()
  local m = monPrimary
  local d = m.dev
  m.rowMap, m.cells = {}, {}
  m.toggleAllBtn, m.timerBtn = nil, nil
  local nSp, nUtil = countItems()
  local hasUtilMon = monUtil.dev ~= nil
  -- fit the scale to exactly what this monitor will hold - heading, the
  -- list itself, and the control rows - with no wasted row, so a dense
  -- list (e.g. ~16 spawners) renders at the largest text that still fits.
  -- a dedicated utility monitor means the utilities do not count here
  fitScale(m, 15, function(cols)
    local ncol = (cols >= MIN_TWOCOL_W) and 2 or 1
    local uHere = hasUtilMon and 0 or nUtil
    local overhead = 1 + (m.color and primaryCtrlRows(cols) or 0) -- heading + controls
    return math.max(5, nSp + math.ceil(uHere / ncol) + overhead)
  end)
  local ok, w, h = pcall(d.getSize)
  if not ok or type(w) ~= "number" then return end
  if m.color then
    d.setTextColor(colors.white)
    d.setBackgroundColor(colors.black)
  end
  d.clear()
  if w < 8 or h < 3 then
    d.setCursorPos(1, 1)
    d.write(truncate("panel", w))
    return
  end
  if ui.screen ~= "main" then
    drawNoticeOn(d, w, h)
    return
  end
  drawMonHeading(m, w, m.color and "SPAWNERS" or "= SPAWNERS =")
  -- list area = everything but the heading and (on touch monitors) the
  -- one or two control rows; basic monitors have no controls
  local ctrlRows = m.color and primaryCtrlRows(w) or 0
  local listH = math.max(1, h - 1 - ctrlRows)
  local spIdx, utilIdx = {}, {}
  for i, sp in ipairs(config.spawners) do
    if isUtility(sp) then utilIdx[#utilIdx + 1] = i else spIdx[#spIdx + 1] = i end
  end
  if #config.spawners == 0 then
    d.setCursorPos(2, 2)
    d.write(truncate("(none configured)", w - 1))
  elseif hasUtilMon then
    -- utilities have their own monitor; show only spawners here
    if #spIdx == 0 then
      d.setCursorPos(2, 2)
      d.write(truncate("(utilities on 2nd monitor)", w - 1))
    elseif #spIdx <= listH then
      local y = 2
      for _, i in ipairs(spIdx) do
        drawSpawnerRow(m, config.spawners[i], i, y, w)
        y = y + 1
      end
    else
      for row = 1, listH do
        local p = ui.mainScroll + row
        if p > #spIdx then break end
        drawSpawnerRow(m, config.spawners[spIdx[p]], spIdx[p], 1 + row, w)
      end
      drawScrollArrows(m, w, listH, ui.mainScroll, #spIdx)
    end
  else
    -- single monitor: spawners on top, utilities two-column at the bottom
    local ncol = #utilColumns(w)
    local uRows = math.ceil(#utilIdx / ncol)
    if #spIdx + uRows <= listH then
      local y = 2
      for _, i in ipairs(spIdx) do
        drawSpawnerRow(m, config.spawners[i], i, y, w)
        y = y + 1
      end
      if #utilIdx > 0 then
        drawUtilList(m, utilIdx, 2, listH, w, true)
      end
    else
      -- too much to fit: contiguous scrolled list, two-column off
      local order = displayOrder()
      local n = #order
      for row = 1, listH do
        local p = ui.mainScroll + row
        if p > n then break end
        drawSpawnerRow(m, config.spawners[order[p]], order[p], 1 + row, w)
      end
      drawScrollArrows(m, w, listH, ui.mainScroll, n)
    end
  end
  if m.color then drawControlRows(m, w, h) end
end

local function drawUtilMonRaw()
  local m = monUtil
  local d = m.dev
  m.rowMap, m.cells = {}, {}
  local _, nUtil = countItems()
  fitScale(m, 8, function(cols)
    local ncol = (cols >= MIN_TWOCOL_W) and 2 or 1
    return math.max(3, math.ceil(nUtil / ncol) + 1)
  end, UTIL_SCALE_BIAS)
  local ok, w, h = pcall(d.getSize)
  if not ok or type(w) ~= "number" then return end
  if m.color then
    d.setTextColor(colors.white)
    d.setBackgroundColor(colors.black)
  end
  d.clear()
  if w < 8 or h < 3 then
    d.setCursorPos(1, 1)
    d.write(truncate("util", w))
    return
  end
  if ui.screen ~= "main" then
    drawNoticeOn(d, w, h)
    return
  end
  drawMonHeading(m, w, m.color and "UTILITIES" or "= UTILITIES =")
  local listH = math.max(1, h - 1)
  local utilIdx = {}
  for i, sp in ipairs(config.spawners) do
    if isUtility(sp) then utilIdx[#utilIdx + 1] = i end
  end
  if #utilIdx == 0 then
    d.setCursorPos(2, 2)
    d.write(truncate("(no utilities)", w - 1))
    return
  end
  local need = math.ceil(#utilIdx / #utilColumns(w))
  if need <= listH then
    drawUtilList(m, utilIdx, 2, listH, w, false)
  else
    -- rare: more utility rows than fit, fall back to a scrolled column
    local n = #utilIdx
    for row = 1, listH do
      local p = ui.mainScroll + row
      if p > n then break end
      drawSpawnerRow(m, config.spawners[utilIdx[p]], utilIdx[p], 1 + row, w)
    end
    drawScrollArrows(m, w, listH, ui.mainScroll, n)
  end
end

local function drawMonitor()
  -- either monitor may detach mid-draw; the detach event cleans up
  if monPrimary.dev then pcall(drawPrimaryRaw) end
  if monUtil.dev then pcall(drawUtilMonRaw) end
end

local function redraw()
  drawTerm()
  drawMonitor()
end

-- ---------------------------------------------------------------------
-- menu item builders
