-- sides on the computer itself are relative to the block
local SELF_SIDES = { "top", "bottom", "left", "right", "front", "back" }
-- sides on a redstone integrator are absolute world directions
local INTEG_SIDES = { "up", "down", "north", "south", "east", "west" }

local function makeSet(list)
  local set = {}
  for _, v in ipairs(list) do set[v] = true end
  return set
end

local SELF_SIDE_SET = makeSet(SELF_SIDES)
local INTEG_SIDE_SET = makeSet(INTEG_SIDES)

local function sidesFor(target)
  if target == "self" then return SELF_SIDES end
  return INTEG_SIDES
end

local function isValidSide(target, side)
  if target == "self" then return SELF_SIDE_SET[side] == true end
  return INTEG_SIDE_SET[side] == true
end

-- ---------------------------------------------------------------------
-- state
-- ---------------------------------------------------------------------

local config

-- runtime-only: [spawner table] = true when the last output write failed;
-- kept out of the config table so it is never serialised
local applyFailed = {}

-- runtime-only countdown timers: [spawner table] = os.clock() deadline.
-- the remaining seconds are mirrored into sp.timerLeft on every save so
-- a countdown survives a reboot (it resumes from the last saved value)
local timerEnds = {}
local tickTimerId = nil

-- runtime-only interval-mode state: phase true = the on half of the
-- pulse; next flip deadlines are os.clock() based. a reboot restarts an
-- active interval spawner at the on phase
local intervalPhase = {}
local intervalNext = {}

-- monitor state. two monitors are driven: monPrimary shows the spawner
-- list plus the touch control rows, and (when it is the only monitor)
-- the utilities as well. monUtil, present only when a second monitor is
-- attached, shows the utilities instead so they never crowd the spawners.
-- each descriptor rebuilds its hit maps on every draw:
--   rowMap  monitor y -> config.spawners index for full-width rows
--   cells   two-column utility hitboxes: { { y, x1, x2, index }, ... }
--   toggleAllBtn / timerBtn  control-button hitboxes { y, x1, x2 }
local monPrimary = {
  dev = nil, name = nil, color = false, scale = 1,
  rowMap = {}, cells = {}, toggleAllBtn = nil, timerBtn = nil,
}
local monUtil = {
  dev = nil, name = nil, color = false, scale = 1,
  rowMap = {}, cells = {},
}

local ui = {
  screen = "main", -- main|settings|edit|pick_target|pick_side|integrators|scan|confirm|input
  mainSel = 1,
  mainScroll = 0,
  sel = 1,      -- selection for menu screens
  scroll = 0,
  items = {},   -- menu items for the current screen
  editIndex = nil,
  timerIndex = nil, -- spawner the timer picker was opened for
  confirm = nil,
  input = nil,
  status = nil, -- transient one-line message
}

-- ---------------------------------------------------------------------
-- small utilities
-- ---------------------------------------------------------------------

local function truncate(s, maxLen)
  if maxLen < 1 then return "" end
  if #s <= maxLen then return s end
  if maxLen == 1 then return string.sub(s, 1, 1) end
  return string.sub(s, 1, maxLen - 1) .. "~"
end

local function formatCountdown(secs)
  secs = math.floor(secs)
  if secs < 0 then secs = 0 end
  local h = math.floor(secs / 3600)
  local m = math.floor((secs % 3600) / 60)
  local s = secs % 60
  if h > 0 then return string.format("%d:%02d:%02d", h, m, s) end
  return string.format("%d:%02d", m, s)
end

local function anyIntervalActive()
  if not config then return false end
  for _, sp in ipairs(config.spawners) do
    if sp.state and (sp.interval or 0) > 0 then return true end
  end
  return false
end

-- keep exactly one 1-second os.startTimer alive while any countdown or
-- interval pulse is running
local function ensureTick()
  if tickTimerId == nil and (next(timerEnds) ~= nil or anyIntervalActive()) then
    tickTimerId = os.startTimer(1)
  end
end

local function cancelSpawnerTimer(sp)
  timerEnds[sp] = nil
  sp.timerLeft = nil
end

-- begin an interval pulse at the on phase
local function startInterval(sp)
  intervalPhase[sp] = true
  intervalNext[sp] = os.clock() + sp.interval
end

local function stopInterval(sp)
  intervalPhase[sp] = nil
  intervalNext[sp] = nil
end

local function timerModeLabel()
  local mode = config.timerMode or 0
  for _, m in ipairs(TIMER_MODES) do
    if m.secs == mode then return m.label end
  end
  return formatCountdown(mode)
end

-- background and text colour for the header bars
local function headerStyle()
  local wanted = (config and config.headerColor) or "blue"
  for _, c in ipairs(HEADER_COLORS) do
    if c.name == wanted then return c.color, c.text end
  end
  return colors.blue, colors.white
end

-- user label for an integrator, with the peripheral name kept visible
local function integLabel(name)
  local l = config.integratorLabels and config.integratorLabels[name]
  if l and l ~= "" then
    return l .. " (" .. name .. ")"
  end
  return name
end

-- an item's type decides where it renders: spawners on top, utilities
-- grouped below (and anchored to the bottom on the monitor)
local function isUtility(sp)
  return sp.itemType == "utility"
end

-- main-screen display order: spawners in config order, then the utility
-- group (rendered anchored to the bottom on the monitor)
local function displayOrder()
  local order = {}
  for i, sp in ipairs(config.spawners) do
    if not isUtility(sp) then order[#order + 1] = i end
  end
  for i, sp in ipairs(config.spawners) do
    if isUtility(sp) then order[#order + 1] = i end
  end
  return order
end

-- only touch colours on colour-capable displays; basic displays keep
-- their white-on-black defaults and rely on text markers instead
local function setColors(t, fg, bg)
  if t.isColor() then
    t.setTextColor(fg)
    t.setBackgroundColor(bg)
  end
end

-- ---------------------------------------------------------------------
-- config load / save
-- ---------------------------------------------------------------------

local function defaultConfig()
  return {
    version = 1,
    spawners = {},
    integrators = {},
    integratorLabels = {},
    timerMode = 0,
    headerColor = "blue",
  }
end

local function validSpawner(sp)
  if type(sp) ~= "table" then return false end
  if type(sp.name) ~= "string" then return false end
  if type(sp.target) ~= "string" then return false end
  if type(sp.side) ~= "string" then return false end
  if type(sp.inverted) ~= "boolean" then return false end
  if type(sp.state) ~= "boolean" then return false end
  -- optional field: seconds left on a running countdown at save time
  if sp.timerLeft ~= nil and type(sp.timerLeft) ~= "number" then return false end
  -- optional field: never attach timers to this spawner
  if sp.ignoreTimer ~= nil and type(sp.ignoreTimer) ~= "boolean" then return false end
  -- optional legacy field: superseded by itemType, still accepted so old
  -- configs load and can be migrated
  if sp.pos ~= nil and sp.pos ~= "top" and sp.pos ~= "bottom" then return false end
  -- optional field: "spawner" or "utility"; utilities group at the bottom
  if sp.itemType ~= nil and sp.itemType ~= "spawner" and sp.itemType ~= "utility" then return false end
  -- optional field: the toggle-all master switch skips this spawner
  if sp.bypassAll ~= nil and type(sp.bypassAll) ~= "boolean" then return false end
  -- optional field: pulse length in seconds; nil/0 = plain on state
  if sp.interval ~= nil and type(sp.interval) ~= "number" then return false end
  if sp.target == "none" then return sp.side == "none" end
  return isValidSide(sp.target, sp.side)
end

local function validConfig(c)
  if type(c) ~= "table" then return false end
  -- bump this check and add migration code here when the schema changes
  if c.version ~= 1 then return false end
  if type(c.spawners) ~= "table" then return false end
  if type(c.integrators) ~= "table" then return false end
  -- optional field: default timer in seconds, 0 = no timer
  if c.timerMode ~= nil and type(c.timerMode) ~= "number" then return false end
  -- optional field: header bar colour name
  if c.headerColor ~= nil and type(c.headerColor) ~= "string" then return false end
  -- optional field: user labels for integrators, keyed by peripheral name
  if c.integratorLabels ~= nil then
    if type(c.integratorLabels) ~= "table" then return false end
    for k, v in pairs(c.integratorLabels) do
      if type(k) ~= "string" or type(v) ~= "string" then return false end
    end
  end
  for _, sp in ipairs(c.spawners) do
    if not validSpawner(sp) then return false end
  end
  for _, name in ipairs(c.integrators) do
    if type(name) ~= "string" or name == "" then return false end
  end
  return true
end

local function saveConfig()
  -- mirror running countdowns into the persisted table so a reboot can
  -- resume them from the last saved remaining time
  local now = os.clock()
  for _, sp in ipairs(config.spawners) do
    local endT = timerEnds[sp]
    if endT then
      sp.timerLeft = math.max(1, math.floor(endT - now))
    else
      sp.timerLeft = nil
    end
  end
  -- serialise to a temp file first so a crash mid-write never leaves a
  -- half-written config behind
  local h = fs.open(CONFIG_TMP, "w")
  if not h then
    ui.status = "could not write config!"
    return
  end
  h.write(textutils.serialize(config))
  h.close()
  -- fs.move refuses to overwrite, so drop the old file just before the
  -- move; the finished temp file survives even if we die between these
  if fs.exists(CONFIG_FILE) then fs.delete(CONFIG_FILE) end
  fs.move(CONFIG_TMP, CONFIG_FILE)
end

local function loadConfig()
  if not fs.exists(CONFIG_FILE) then
    config = defaultConfig()
    return
  end
  local h = fs.open(CONFIG_FILE, "r")
  local text
  if h then
    text = h.readAll()
    h.close()
  end
  local data
  if text then data = textutils.unserialize(text) end
  if validConfig(data) then
    config = data
    -- older configs predate these optional fields
    if type(config.timerMode) ~= "number" then config.timerMode = 0 end
    if type(config.integratorLabels) ~= "table" then config.integratorLabels = {} end
    -- itemType supersedes the old top/bottom pos field: a bottom-anchored
    -- row becomes a utility, everything else a spawner
    for _, sp in ipairs(config.spawners) do
      if sp.itemType ~= "spawner" and sp.itemType ~= "utility" then
        sp.itemType = (sp.pos == "bottom") and "utility" or "spawner"
      end
    end
  else
    -- unreadable or wrong shape: keep it for inspection, start fresh
    if fs.exists(CONFIG_BAK) then fs.delete(CONFIG_BAK) end
    fs.move(CONFIG_FILE, CONFIG_BAK)
    config = defaultConfig()
    saveConfig()
  end
end

-- ---------------------------------------------------------------------
-- redstone output
-- ---------------------------------------------------------------------

-- write the spawner's logical state to its output, honouring polarity.
-- an on spawner in interval mode emits its current pulse phase instead
-- of a steady level
local function applyOutput(sp)
  if sp.target == "none" then return end
  local physical = sp.state
  if physical and (sp.interval or 0) > 0 then
    physical = intervalPhase[sp] ~= false
  end
  if sp.inverted then physical = not physical end
  local ok
  if sp.target == "self" then
    ok = pcall(redstone.setOutput, sp.side, physical)
  else
    ok = pcall(peripheral.call, sp.target, "setOutput", sp.side, physical)
  end
  if ok then
    applyFailed[sp] = nil
  else
    applyFailed[sp] = true
  end
end

-- drive the output to the level that means "machine off"; used before a
-- spawner is removed or its target/side is reassigned, so the abandoned
-- face is never left holding the machine on
local function forceLogicalOff(sp)
  if sp.target == "none" then return end
  local physical = sp.inverted -- logical off is electrical high when inverted
  if sp.target == "self" then
    pcall(redstone.setOutput, sp.side, physical)
  else
    pcall(peripheral.call, sp.target, "setOutput", sp.side, physical)
  end
  applyFailed[sp] = nil
end

local function applyAll()
  for _, sp in ipairs(config.spawners) do
    applyOutput(sp)
  end
end

-- ---------------------------------------------------------------------
-- peripherals
-- ---------------------------------------------------------------------

local function integratorPresent(name)
  return peripheral.isPresent(name)
    and peripheral.getType(name) == "redstone_integrator"
end

local function knownIntegrator(name)
  for _, n in ipairs(config.integrators) do
    if n == name then return true end
  end
  return false
end

local function spawnerOffline(sp)
  if sp.target == "self" or sp.target == "none" then return false end
  return (not integratorPresent(sp.target)) or applyFailed[sp] == true
end

local function scanForIntegrators()
  local found = {}
  for _, name in ipairs(peripheral.getNames()) do
    local ok, ptype = pcall(peripheral.getType, name)
    if ok and ptype == "redstone_integrator" and not knownIntegrator(name) then
      found[#found + 1] = name
    end
  end
  return found
end

-- count configured items split by type
local function countItems()
  local nSp, nUtil = 0, 0
  if config then
    for _, sp in ipairs(config.spawners) do
      if isUtility(sp) then nUtil = nUtil + 1 else nSp = nSp + 1 end
    end
  end
  return nSp, nUtil
end

-- pick the largest text scale where the layout still fits: at least
-- minCols columns for name + status, and enough rows. rowsFor(cols) maps
-- the columns available at a candidate scale to the rows the layout then
-- needs, so a two-column utility block can claim fewer rows at wider
-- scales. converges because the scale-1 grid is fixed by the physical
-- monitor size
local function fitScale(m, minCols, rowsFor, biasDown)
  if not m.dev then return end
  local ok, w, h = pcall(m.dev.getSize)
  if not ok or type(w) ~= "number" then return end
  local w1 = w * m.scale -- character grid the monitor would have at scale 1
  local h1 = h * m.scale
  local s = 5
  while s > 0.5 do
    local cols = math.floor(w1 / s)
    local rows = math.floor(h1 / s)
    if cols >= minCols and rows >= rowsFor(cols) then break end
    s = s - 0.5
  end
  -- an optional downward nudge shrinks text below the best fit (always
  -- safe: smaller text only frees space). never below the 0.5 minimum
  if biasDown and biasDown > 0 then
    s = math.max(0.5, s - biasDown)
  end
  if s ~= m.scale then
    m.scale = s
    pcall(m.dev.setTextScale, s)
  end
end

-- point descriptor m at (dev, name); a re-attach of the same monitor
-- keeps the scale we already picked, a new one resets to scale 1 and lets
-- the next draw re-fit
local function attachMonitor(m, dev, name)
  if m.name == name and m.dev then
    m.dev = dev
    return
  end
  m.dev, m.name = dev, name
  m.color = false
  if dev then
    local ok, c = pcall(dev.isColor)
    m.color = (ok and c) or false -- advanced monitors are the colour ones
    m.scale = 1
    pcall(dev.setTextScale, 1)
  end
end

local function detachMonitor(m)
  m.dev, m.name = nil, nil
  m.color = false
  m.scale = 1
end

-- assign attached monitors to roles. the two lowest-named monitors win:
-- the first is the primary (spawners + controls), the second, if any,
-- becomes the dedicated utilities monitor. sorting by name keeps a given
-- physical monitor in the same role across rescans
local function findMonitors()
  local list = {}
  peripheral.find("monitor", function(name, dev)
    list[#list + 1] = { name = name, dev = dev }
    return false
  end)
  table.sort(list, function(a, b) return a.name < b.name end)
  if list[1] then attachMonitor(monPrimary, list[1].dev, list[1].name)
  else detachMonitor(monPrimary) end
  if list[2] then attachMonitor(monUtil, list[2].dev, list[2].name)
  else detachMonitor(monUtil) end
end

local function removeIntegratorByName(name)
  if config.integratorLabels then config.integratorLabels[name] = nil end
  for i, n in ipairs(config.integrators) do
    if n == name then
      table.remove(config.integrators, i)
      return
    end
  end
end

-- ---------------------------------------------------------------------
-- layout helpers
-- ---------------------------------------------------------------------

local function termMainListH()
  local _, h = term.getSize()
  return math.max(1, h - 5)
end

local function termMenuListH()
  local _, h = term.getSize()
  return math.max(1, h - 4)
end

local function clampMainScroll()
  local listH = termMainListH()
  local n = #config.spawners
  if ui.mainSel < 1 then ui.mainSel = 1 end
  if ui.mainSel > n then ui.mainSel = math.max(1, n) end
  if ui.mainScroll > ui.mainSel - 1 then ui.mainScroll = ui.mainSel - 1 end
  if ui.mainSel > ui.mainScroll + listH then ui.mainScroll = ui.mainSel - listH end
  local maxScroll = math.max(0, n - listH)
  if ui.mainScroll > maxScroll then ui.mainScroll = maxScroll end
  if ui.mainScroll < 0 then ui.mainScroll = 0 end
end

local function clampMenuScroll()
  local listH = termMenuListH()
  local n = #ui.items
  if ui.sel < 1 then ui.sel = 1 end
  if ui.sel > n then ui.sel = math.max(1, n) end
  if ui.scroll > ui.sel - 1 then ui.scroll = ui.sel - 1 end
  if ui.sel > ui.scroll + listH then ui.scroll = ui.sel - listH end
  local maxScroll = math.max(0, n - listH)
  if ui.scroll > maxScroll then ui.scroll = maxScroll end
  if ui.scroll < 0 then ui.scroll = 0 end
end

-- ---------------------------------------------------------------------
-- rendering
-- ---------------------------------------------------------------------

local function spawnerStatusText(sp)
  if sp.target == "none" then return "---", colors.lightGray end
  if sp.state then
    -- interval mode still reads ON, but faintly during the off half of
    -- the pulse so the current phase is visible at a glance
    if (sp.interval or 0) > 0 and intervalPhase[sp] == false then
      return "ON", colors.green
    end
    return "ON", colors.lime
  end
  return "OFF", colors.red
end

local function drawTooSmall(t, w, h)
  t.setCursorPos(1, 1)
  t.write(truncate("terminal too small", w))
  if h >= 2 then
    t.setCursorPos(1, 2)
    t.write(truncate("need at least 26x8", w))
  end
end

local function drawTitleBar(t, w, title)
  local bg, fg = headerStyle()
  setColors(t, fg, bg)
  t.setCursorPos(1, 1)
  t.clearLine()
  t.setCursorPos(2, 1)
  t.write(truncate(title, w - 2))
  setColors(t, colors.white, colors.black)
end

local function drawTermMain()
  local t = term
  local w, h = t.getSize()
  setColors(t, colors.white, colors.black)
  t.clear()
  if w < 26 or h < 8 then
    drawTooSmall(t, w, h)
    return
  end
  clampMainScroll()
  drawTitleBar(t, w, "Spawner Control Panel")
  local listH = termMainListH()
  local n = #config.spawners
  local anyOffline = false
  for _, sp in ipairs(config.spawners) do
    if spawnerOffline(sp) then
      anyOffline = true
      break
    end
  end
  if n == 0 then
    t.setCursorPos(2, 3)
    t.write("(no spawners configured)")
    t.setCursorPos(2, 4)
    t.write("press A to open settings")
  else
    local order = displayOrder()
    for row = 1, listH do
      local p = ui.mainScroll + row
      if p > n then break end
      local sp = config.spawners[order[p]]
      local y = 2 + row
      local selected = (p == ui.mainSel)
      if selected then
        setColors(t, colors.white, colors.gray)
        t.setCursorPos(1, y)
        t.clearLine()
      end
      t.setCursorPos(1, y)
      t.write(selected and ">" or " ")
      local endT = timerEnds[sp]
      t.setCursorPos(3, y)
      -- utilities read as secondary rows: dimmed unless highlighted
      if isUtility(sp) and not selected and t.isColor() then
        t.setTextColor(colors.lightGray)
      end
      t.write(truncate(sp.name, endT and (w - 21) or (w - 13)))
      if t.isColor() then t.setTextColor(colors.white) end
      if endT then
        local cd = formatCountdown(endT - os.clock())
        if t.isColor() then t.setTextColor(colors.cyan) end
        t.setCursorPos(w - 9 - #cd, y)
        t.write(cd)
        if t.isColor() then t.setTextColor(colors.white) end
      end
      local offline = spawnerOffline(sp)
      if offline then
        if t.isColor() then t.setTextColor(colors.yellow) end
        t.setCursorPos(w - 8, y)
        t.write("!")
        if t.isColor() then t.setTextColor(colors.white) end
      end
      local text, col = spawnerStatusText(sp)
      -- right-align the bracket group so "]" always sits at w-2
      t.setCursorPos(w - 3 - #text, y)
      t.write("[")
      if t.isColor() then t.setTextColor(col) end
      t.write(text)
      if t.isColor() then t.setTextColor(colors.white) end
      t.write("]")
      if selected then setColors(t, colors.white, colors.black) end
    end
    if ui.mainScroll > 0 then
      t.setCursorPos(w, 3)
      t.write("^")
    end
    if ui.mainScroll + listH < n then
      t.setCursorPos(w, 2 + listH)
      t.write("v")
    end
  end
  -- settings entry point and the persistent default-timer mode
  t.setCursorPos(2, h - 1)
  if t.isColor() then t.setTextColor(colors.yellow) end
  t.write("[A]")
  if t.isColor() then t.setTextColor(colors.white) end
  t.write(" Settings  ")
  if t.isColor() then t.setTextColor(colors.cyan) end
  t.write(truncate("Timer: " .. timerModeLabel() .. " (M)", w - 15))
  if t.isColor() then t.setTextColor(colors.white) end
  -- status / key hint line
  t.setCursorPos(2, h)
  if ui.status then
    if t.isColor() then t.setTextColor(colors.yellow) end
    t.write(truncate(ui.status, w - 2))
  else
    if t.isColor() then t.setTextColor(colors.lightGray) end
    local hint = "Space toggle  Tab all  T timer  A settings"
    if anyOffline then hint = "Space toggle  Tab all  A settings  !=offline" end
    t.write(truncate(hint, w - 2))
  end
  if t.isColor() then t.setTextColor(colors.white) end
end

local function drawTermMenu(title, hint)
  local t = term
  local w, h = t.getSize()
  setColors(t, colors.white, colors.black)
  t.clear()
  if w < 26 or h < 8 then
    drawTooSmall(t, w, h)
    return
  end
  clampMenuScroll()
  drawTitleBar(t, w, title)
  local listH = termMenuListH()
  for row = 1, listH do
    local i = ui.scroll + row
    if i > #ui.items then break end
    local it = ui.items[i]
    local y = 2 + row
    local selected = (i == ui.sel)
    if selected then
      setColors(t, colors.white, colors.gray)
      t.setCursorPos(1, y)
      t.clearLine()
    end
    t.setCursorPos(1, y)
    t.write(selected and ">" or " ")
    if it.dim and not selected and t.isColor() then
      t.setTextColor(colors.lightGray)
    elseif it.fg and t.isColor() then
      t.setTextColor(it.fg)
    end
    t.setCursorPos(3, y)
    t.write(truncate(it.label, w - 4))
    setColors(t, colors.white, colors.black)
  end
  if ui.scroll > 0 then
    t.setCursorPos(w, 3)
    t.write("^")
  end
  if ui.scroll + listH < #ui.items then
    t.setCursorPos(w, 2 + listH)
    t.write("v")
  end
  if ui.status then
    t.setCursorPos(2, h - 1)
    if t.isColor() then t.setTextColor(colors.yellow) end
    t.write(truncate(ui.status, w - 2))
  end
  t.setCursorPos(2, h)
  if t.isColor() then t.setTextColor(colors.lightGray) end
  t.write(truncate(hint or "Up/Dn move  Enter select  Backspace back", w - 2))
  if t.isColor() then t.setTextColor(colors.white) end
end

