-- =====================================================================
-- installer / updater for the spawner control panel
--
-- fetches the latest "startup" from github, deletes the old copy and
-- puts the new one in its place. safe to re-run any time: the download
-- happens first, so a failed fetch never leaves the computer without
-- a startup program.
--
-- usage (first time, on the computer):
--   wget https://raw.githubusercontent.com/EvodiAaron/spawner-orchestrator/main/install install
--   install
-- afterwards just run "install" again to update. on success the
-- computer reboots itself to start the panel.
--
-- requires http to be enabled in the server's computercraft config
-- (http_enable = true, the default on most packs). for instant updates
-- the http whitelist must allow api.github.com; if only
-- raw.githubusercontent.com is allowed the installer falls back to it,
-- which can lag a few minutes behind a push (a cdn cache).
-- =====================================================================

local REPO = "EvodiAaron/spawner-orchestrator"
local BRANCH = "main"
-- the github api's "raw" media type returns the file's current bytes and,
-- unlike raw.githubusercontent.com, is not served from a ~5 minute cdn
-- cache - so installing right after a push picks up the new code at once.
-- (raw.githubusercontent ignores cache-busting query strings, so a plain
-- ?t= trick does not help there.)
local API_URL = "https://api.github.com/repos/" .. REPO .. "/contents/startup?ref=" .. BRANCH
local RAW_URL = "https://raw.githubusercontent.com/" .. REPO .. "/" .. BRANCH .. "/startup"
local TARGET = "startup"
local TMP = "startup.new"

-- github's api requires a user-agent; the raw media type asks for the
-- file contents directly instead of the default base64-in-json wrapper
local HEADERS = {
  ["Accept"] = "application/vnd.github.raw",
  ["User-Agent"] = "spawner-orchestrator-installer",
}

if not http then
  print("http is disabled in the computercraft config;")
  print("cannot download. copy the file in by hand instead.")
  return
end

print("downloading " .. TARGET .. " ...")
local res = http.get(API_URL, HEADERS)
if not res then
  -- api blocked or rate-limited: try the raw host (may lag a push)
  print("api fetch failed; trying raw host...")
  res = http.get(RAW_URL)
end
if not res then
  print("download failed - check the url and your")
  print("server's http whitelist. nothing was changed.")
  return
end

local body = res.readAll()
res.close()

-- sanity check: make sure we got the panel and not an error page
if not body or #body == 0
  or not string.find(body, "spawner control panel", 1, true) then
  print("downloaded content does not look like the")
  print("panel - aborting. nothing was changed.")
  return
end

local h = fs.open(TMP, "w")
if not h then
  print("could not write " .. TMP .. " - aborting.")
  return
end
h.write(body)
h.close()

-- the download is safely on disk; now delete the old copy and swap in
if fs.exists(TARGET) then fs.delete(TARGET) end
fs.move(TMP, TARGET)

print("installed " .. TARGET .. " (" .. #body .. " bytes).")
print("rebooting in 3 seconds to start the panel...")
sleep(3)
os.reboot()
